{
  "version": 1,
  "sdk_version": "3.0.4",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://wwjfweofvxooyvlhoody.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "partnericaretele-p-drna",
      "version": "0.1.0",
      "title": "partnericaretele(P)(DrNa)"
    },
    "tools": [
      {
        "name": "list_patients",
        "title": "List patients",
        "description": "List patients the signed-in user is allowed to see, optionally filtered by name or patient reference.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "search": {
              "description": "Part of a name or patient reference.",
              "type": "string",
              "maxLength": 80
            },
            "limit": {
              "description": "Maximum rows (default 25).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_consultations",
        "title": "List consultations",
        "description": "List recent telemedicine consultations visible to the signed-in user, optionally by status or patient.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "status": {
              "description": "Filter by consultation status.",
              "type": "string",
              "enum": [
                "CREATED",
                "WAITING",
                "STARTED",
                "COMPLETED",
                "CANCELLED",
                "FAILED",
                "NO_SHOW"
              ]
            },
            "patient_id": {
              "description": "Only consultations for this patient id.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "limit": {
              "description": "Maximum rows (default 25).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
